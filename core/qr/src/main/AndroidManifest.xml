<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Asked for only when the user scans a QR anchor. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application>
        <!-- Shares printable QR anchors from the app cache; not exported, grants per share. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.qrfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/core_qr_file_paths" />
        </provider>
    </application>

</manifest>
