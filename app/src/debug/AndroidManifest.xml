<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!-- Debug only: `adb` NFC tap simulator. DUMP is held by adb shell, never by third-party apps. -->
        <receiver
            android:name=".SimulateTapReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="io.github.uveshm003.anchor.SIMULATE_TAP" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
